<?xml version="1.0" encoding="utf-8"?>
<!-- SO101 with simplified box collision geometry for tuning -->
<!-- Based on so101.urdf but with manually tunable collision boxes -->
<robot name="so101_simple_collision">

  <!-- Materials -->
  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Link base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>

    <!-- Visual: Keep original detailed meshes -->
    <visual>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/base_motor_holder_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/base_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <visual>
      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Base servo and holder -->
    <!-- TUNE THIS: Adjust size (x,y,z) and origin to cover base volume -->
    <!-- Extends a few mm beyond actual geometry for clearance -->
    <collision>
      <origin xyz="-0.012 0.0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.05 0.07"/>
        <!-- X: width (left-right), Y: depth (front-back), Z: height (up) -->
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.04 0.0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.035 0.02"/>
        <!-- X: width (left-right), Y: depth (front-back), Z: height (up) -->
      </geometry>
    </collision>

    <!-- Collision: Mounting plate - left extension -->
    <!-- TUNE THIS: Covers the extending mounting plate on left side -->
    <collision>
      <origin xyz="0.01 0.04 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.018"/>
      </geometry>
    </collision>

    <!-- Collision: Mounting plate - right extension -->
    <!-- TUNE THIS: Covers the extending mounting plate on right side -->
    <collision>
      <origin xyz="0.01 -0.04 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.018"/>
      </geometry>
    </collision>
  </link>

  <!-- Link shoulder -->
  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
    </inertial>

    <!-- Visual: Keep original meshes -->
    <visual>
      <origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <visual>
      <origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/motor_holder_so101_base_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/rotation_pitch_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Single box for shoulder pivot region -->
    <!-- TUNE THIS: Shortened to exclude joint connection points -->
    <!-- first narrower box near the base-->
    <collision>
      <origin xyz="-0.036 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.040 0.04"/>
        <!-- Covers servo and pivot, excludes mounting ends -->
      </geometry>
    </collision>
    <!-- thicker part near the next servo -->
    <collision>
      <origin xyz="-0.032 0.0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.055 0.025"/>
        <!-- Covers servo and pivot, excludes mounting ends -->
      </geometry>
    </collision>
  </link>

  <!-- Link upper_arm -->
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>

    <!-- Visual: Keep original meshes -->
    <visual>
      <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 -5.27356e-16 -1.5708"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <visual>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/upper_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Elongated box for upper arm segment -->
    <!-- TUNE THIS: Length and width to cover arm, SHORTENED at ends -->
    <!-- Center positioned in middle of arm segment (not at joint) -->
    <collision>
      <origin xyz="-0.065 0.0 0.0182" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.026 0.07"/>
        <!-- X: arm length (shortened), Y: width, Z: thickness -->
        <!-- Original arm ~0.113m, shortened to ~0.08m (exclude joints) -->
      </geometry>
    </collision>
  </link>

  <!-- Link lower_arm -->
  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>

    <!-- Visual: Keep original meshes -->
    <visual>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/under_arm_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 -2.55351e-15 -1.83387e-30"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/motor_holder_so101_wrist_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <visual>
      <origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 -7.88861e-31 -3.14159"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>

    <!-- Collision: Elongated box for lower arm segment -->
    <!-- TUNE THIS: Similar to upper arm, shortened at ends -->
    <collision>
      <origin xyz="-0.065 -0.00 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.025 0.07"/>
        <!-- X: arm length (shortened), Y: width, Z: thickness -->
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.105 0.003 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.036 0.07"/>
        <!-- X: arm length (shortened), Y: width, Z: thickness -->
      </geometry>
    </collision>
  </link>

  <!-- Link wrist -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>

    <!-- Visual: Keep original meshes -->
    <visual>
      <origin xyz="8.32667e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_no_horn_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <visual>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/wrist_roll_pitch_so101_v2.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Small box for wrist region -->
    <!-- TUNE THIS: Covers wrist servo and pitch mechanism -->
    <!-- smaller box near the lower link -->
    <collision>
      <origin xyz="0.00 -0.028 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.034 0.062"/>
      </geometry>
    </collision>

    <!-- larger box near the gripper -->
    <collision>
      <origin xyz="-0.002 -0.045 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.033 0.058"/>
      </geometry>
    </collision>
  </link>

  <!-- Link gripper -->
  <link name="gripper_link">
    <inertial>
      <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>
    </inertial>

    <!-- Visual: Keep original meshes -->
    <visual>
      <origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.19179e-17 -1.66533e-16"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/sts3215_03a_v1.stl"/>
      </geometry>
      <material name="sts3215"/>
    </visual>
    <visual>
      <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/wrist_roll_follower_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Box for gripper servo region -->
    <!-- TUNE THIS: Main gripper body with servo -->
    <collision>
      <origin xyz="-0.0024 -0.0002 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.066 0.032 0.032"/>
      </geometry>
    </collision>

    <!-- second thicker box around gripper servo-->
    <collision>
      <origin xyz="-0.0020 -0.0002 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.052 0.032"/>
      </geometry>
    </collision>

    <!-- Collision: Static gripper jaw -->
    <!-- TUNE THIS: Covers the fixed gripper jaw extension -->
    <!--thinner part of the jaw-->
    <collision>
      <origin xyz="-0.017 0.0 -0.08" rpy="0 -0.17 0"/>
      <geometry>
        <box size="0.012 0.015 0.05"/>
      </geometry>
    </collision>
    <!--thicker part of the jaw-->
    <collision>
      <origin xyz="-0.022 0.0 -0.05" rpy="0 -0.12 0"/>
      <geometry>
        <box size="0.02 0.026 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper frame (dummy link + fixed joint) -->
  <link name="gripper_frame_link">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Link moving_jaw (gripper finger) -->
  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
    </inertial>

    <!-- Visual: Keep original -->
    <visual>
      <origin xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24"/>
      <geometry>
        <mesh filename="package://example-robot-data/robots/so_arm_description/meshes/so101/moving_jaw_so101_v1.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>

    <!-- Collision: Small box for gripper finger -->
    <!-- TUNE THIS: Adjust if you care about gripper collision -->
    <collision>
      <origin xyz="-0.005 -0.067 0.02" rpy="0 0.0 -0.2"/>
      <geometry>
        <box size="0.011 0.032 0.018"/>
      </geometry>
    </collision>
    <!-- second thicker, shorter box around finger-->
    <collision>
      <origin xyz="-0.002 -0.04 0.02" rpy="0 0 -0.1"/>
      <geometry>
        <box size="0.02 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- All joints remain unchanged -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>

  <joint name="wrist_roll" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

</robot>
